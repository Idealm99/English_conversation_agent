# scripts/start.sh 가 읽는 환경변수 템플릿.
# 사용법:
#   cp Scripts/.env.local.example Scripts/.env.local
#   # Scripts/.env.local 을 본인 값으로 채운 뒤
#   bash Scripts/start.sh
#
# 이 파일은 bash로 source 됩니다. 공백/특수문자가 있는 값은 따옴표 필수.
#   GOOD:  VOICE_GREETING="Hi! What's up?"
#   BAD:   VOICE_GREETING=Hi! What's up?

# =============================================================================
# 최소 구성 — 웹 채팅(/web/, /chat, /conversation) 만 쓸 때 이 한 줄만 필요
# =============================================================================
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1   # 선택, 기본값 us-central1

# 빠른 흐름 확인 — LLM 호출 없이 고정 응답으로 동작. GCP_PROJECT 도 불필요해짐.
# CHAT_STUB_RESPONSE="Got it. Tell me more."


# =============================================================================
# 음성 통화 (Twilio Voice + Media Streams) — 사용할 때만 채우기
# =============================================================================
# 아래 4개가 모두 차야 /voice/* 엔드포인트가 동작. 비어있어도 웹 채팅엔 영향 없음.

# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+15733675930

# ngrok 공개 URL (비워두고 AUTO_NGROK=1 로 실행하면 자동 탐지 시도)
# PUBLIC_BASE_URL=


# =============================================================================
# 음성 옵션 (영어 회화 기본값. 한국어 쓸 거면 ko-KR 로)
# =============================================================================
# STT_LANGUAGE=en-US
# STT_MODEL=phone_call             # 영어만 지원. ko-KR 이면 비울 것.
# TTS_VOICE_NAME=en-US-Neural2-J
# VOICE_GREETING="Hi! Let's practice English. What's on your mind today?"


# =============================================================================
# 기타
# =============================================================================
# PORT=8000                        # uvicorn 포트 (기본 8000)
# DEBUG=true                       # 디버그 로그
